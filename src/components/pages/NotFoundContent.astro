---
import Button from "../ui/Button.astro";
import { getLocale, useT, localizePath } from "../../lib/i18n";

const locale = getLocale(Astro.url);
useT(locale);
const s = {
  en: {
    h: "This address doesn't exist yet.",
    p: "The page you're looking for may have moved. Let's get you back on plan.",
    home: "Back to Home",
    projects: "Explore Projects",
  },
  hi: {
    h: "यह पता अभी मौजूद नहीं है।",
    p: "आप जिस पृष्ठ की तलाश कर रहे हैं वह स्थानांतरित हो सकता है। आइए आपको वापस सही राह पर ले चलें।",
    home: "होम पर वापस जाएँ",
    projects: "परियोजनाएँ देखें",
  },
}[locale];
---

<section class="flex min-h-[70vh] items-center bg-offwhite py-24">
  <div class="container-content text-center">
    <p class="font-display text-[120px] leading-none text-brown-200 lg:text-[180px]">404</p>
    <h1 class="mt-4 font-display text-4xl text-brown-dark lg:text-5xl">{s.h}</h1>
    <p class="mx-auto mt-4 max-w-md text-ink-soft">{s.p}</p>
    <div class="mt-9 flex flex-wrap justify-center gap-4">
      <Button href={localizePath("/", locale)} variant="accent" size="lg">{s.home}</Button>
      <Button href={localizePath("/projects", locale)} variant="outline" size="lg">{s.projects}</Button>
    </div>
  </div>
</section>
