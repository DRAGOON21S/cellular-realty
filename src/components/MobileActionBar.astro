---
// Sticky mobile action bar — Call · WhatsApp · Enquire (content-spec Part B).
import { site } from "../data/global";
import { useT, type Locale } from "../lib/i18n";

export interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const t = useT(locale);
---

<div
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-[color:var(--color-line)] bg-offwhite/95 backdrop-blur-sm lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <a
    href={`tel:${site.phones[0].tel}`}
    class="flex flex-col items-center justify-center gap-1 py-2.5 text-[11px] font-semibold uppercase tracking-wide text-brown-dark"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
    {t.mobileBar.call}
  </a>
  <a
    href={site.whatsapp.url}
    target="_blank"
    rel="noopener"
    class="flex flex-col items-center justify-center gap-1 border-x border-[color:var(--color-line)] py-2.5 text-[11px] font-semibold uppercase tracking-wide text-brown-dark"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.07 2.89 1.22 3.09.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35ZM12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-2.85.89.9-2.78-.2-.31A8.2 8.2 0 1 1 12 20.2Z"/></svg>
    {t.mobileBar.whatsapp}
  </a>
  <button
    type="button"
    data-enquire
    class="flex flex-col items-center justify-center gap-1 bg-brown-dark py-2.5 text-[11px] font-semibold uppercase tracking-wide text-offwhite"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>
    {t.mobileBar.enquire}
  </button>
</div>
