---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileActionBar from "../components/MobileActionBar.astro";
import EnquiryModal from "../components/EnquiryModal.tsx";
import { site } from "../data/global";
import { enquiryProjectOptions } from "../lib/cms";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Transparent header over a full-bleed hero (home/about/buyers) */
  transparentHeader?: boolean;
  /** Extra JSON-LD structured data objects to inject */
  jsonLd?: Record<string, unknown>[];
  /** Show the "Be the First to Know What's Next" newsletter band above the footer */
  newsletter?: boolean;
}

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: site.brand,
  legalName: site.parentEntity,
  url: site.url,
  email: site.email,
  telephone: site.phones[0].tel,
  foundingDate: String(site.established),
  address: {
    "@type": "PostalAddress",
    streetAddress: site.office.lines[0],
    addressLocality: "Gurugram",
    addressRegion: "Haryana",
    postalCode: "122001",
    addressCountry: "IN",
  },
  sameAs: [site.social.instagram.url, site.social.facebook.url, site.social.youtube.url],
};

const {
  title = `${site.brand} | ${site.tagline}`,
  description = "Licensed, well-planned DDJAY plotted townships across Jhajjar and Delhi NCR by Cellular Realty.",
  ogImage = "/brand/cellular-realty-favicon.png",
  noindex = false,
  transparentHeader = false,
  jsonLd = [],
  newsletter = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const structuredData = [orgSchema, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/brand/cellular-realty-favicon.svg" />
    <link rel="icon" type="image/png" href="/brand/cellular-realty-favicon.png" />
    <link rel="apple-touch-icon" href="/brand/cellular-realty-favicon.png" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {structuredData.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-brown-dark focus:px-4 focus:py-2 focus:text-offwhite"
      >Skip to content</a
    >

    <Header transparent={transparentHeader} />

    <main id="main">
      <slot />
    </main>

    <Footer newsletter={newsletter} />
    <MobileActionBar />

    <!-- Universal Enquiry modal — any [data-enquire] trigger opens it. -->
    <EnquiryModal projectOptions={enquiryProjectOptions} client:idle />

  </body>
</html>
