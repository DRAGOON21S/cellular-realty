---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { articles } from "../../lib/cms";

const [lead, ...rest] = articles;
---

<Layout
  title="Insights — Cellular Realty"
  description="Location insights and investment guides on Jhajjar, Reliance MET City and the Delhi NCR growth corridor."
  newsletter={true}
>
  <section class="bg-offwhite py-16 lg:py-24">
    <div class="container-content">
      <p class="eyebrow">Knowledge Hub</p>
      <h1 class="mt-4 font-display text-5xl leading-[1.05] text-brown-dark lg:text-7xl">
        Location, Growth &amp; Ownership Insights
      </h1>
      <p class="mt-5 max-w-xl text-lg text-ink-soft">
        Location stories and investment perspectives shaped by connectivity, planning and long-term
        regional growth.
      </p>

      {lead && (
        <a href={`/insights/${lead.slug}`} class="group mt-14 grid gap-8 overflow-hidden border border-[color:var(--color-line)] bg-offwhite lg:grid-cols-2">
          <div class="aspect-[16/10] overflow-hidden lg:aspect-auto">
            <img src={lead.image ?? undefined} alt={lead.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
          </div>
          <div class="flex flex-col justify-center p-8 lg:p-12">
            <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-brown-lightest">{lead.category} • {lead.readTime}</p>
            <h2 class="mt-3 font-display text-3xl leading-tight text-brown-dark lg:text-4xl">{lead.title}</h2>
            <p class="mt-4 text-[16px] leading-relaxed text-ink-soft">{lead.excerpt}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-[12px] font-semibold uppercase tracking-[0.12em] text-brown-dark">
              Read Article <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </span>
          </div>
        </a>
      )}

      <div class="mt-10 grid gap-10 md:grid-cols-2">
        {rest.map((a) => (
          <article class="group flex flex-col">
            <a href={`/insights/${a.slug}`} class="block aspect-[16/10] overflow-hidden">
              <img src={a.image ?? undefined} alt={a.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
            </a>
            <p class="mt-5 text-[12px] font-semibold uppercase tracking-[0.12em] text-brown-lightest">{a.category} • {a.readTime}</p>
            <h3 class="mt-2 font-display text-2xl leading-tight text-brown-dark"><a href={`/insights/${a.slug}`} class="hover:text-brown-600">{a.title}</a></h3>
            <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">{a.excerpt}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
