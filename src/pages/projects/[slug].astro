---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/ui/Button.astro";
import Lightbox from "../../components/Lightbox.tsx";
import { Icon } from "astro-icon/components";
import { projects, type Project } from "../../lib/cms";
import { amenityIcon, connectivityIcon } from "../../lib/icons";
import { amenitySvg } from "../../lib/amenity-icons";
import { isAiImage } from "../../lib/ai-images";
import { site } from "../../data/global";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
interface Props { project: Project; }
const { project: p } = Astro.props;

const reraDisplay = p.reraNumber && !/awaited|on registration|registration confirmed/i.test(p.reraNumber) ? p.reraNumber : "On registration";
const locationFull = p.locationShort.includes(p.state) ? p.locationShort : `${p.locationShort}, ${p.state}`;

// Spec §0.9 / §5.2: layout, demarcation, site-plan, masterplan and planning-render
// assets may ONLY appear inside the gated 3D-masterplan module — never in the hero,
// Project Scope carousel or Project Gallery. Exclude those types from all public image sets.
const PLANNING_ASSET = /location ?map|layout|demarcation|master ?plan|site ?plan|3d|render/i;
const galleryImages = p.gallery.filter((g) => g.src && !PLANNING_ASSET.test(g.type));
const heroImages = [p.heroImage, ...galleryImages.map((g) => g.src)].filter(Boolean).slice(0, 6) as string[];
const scopeImages = galleryImages.filter((g) => /scope|entrance|infrastructure|aerial/i.test(g.type + g.title)).map((g) => g.src!).slice(0, 5);
const locationMap = p.gallery.find((g) => /location map/i.test(g.type))?.src;
const overview = p.section01Body ?? p.heroDescription;

// Development-timeline status → pill tone. Completed shows a check; in-progress
// is a filled pill; not-started/upcoming is a muted outline.
const timelineTone = (status: string | null): "done" | "progress" | "pending" | null => {
  const s = (status ?? "").toLowerCase();
  if (!s || s === "to be updated") return null;
  if (s.includes("complet") && !s.includes("nearing")) return "done";
  if (s.includes("nearing") || s.includes("progress") || s.includes("ongoing")) return "progress";
  return "pending"; // not started / upcoming / planned
};
const brochure = p.downloads.find((d) => /brochure/i.test(d.type) && d.available);

// Amenities — cap to the design's grid (7-col × 2 = 14).
const amenities = p.amenities.slice(0, 14);

// Connectivity grouped into the 3 buckets the design shows.
const groupOf = (cat: string) =>
  /highway|transport|airport/i.test(cat) ? "Highway Access"
  : /employment|city|region|convenience/i.test(cat) ? "Industrial & Business Hubs"
  : "Education & Institutions";
const connGroups: Record<string, typeof p.connectivity> = {};
for (const c of p.connectivity) (connGroups[groupOf(c.category)] ??= []).push(c);
const connIcon: Record<string, string> = {
  "Highway Access": "lucide:milestone",
  "Industrial & Business Hubs": "lucide:briefcase",
  "Education & Institutions": "lucide:graduation-cap",
};

// Gallery categories
const catMatch = {
  Infrastructure: /infrastructure|entrance|road|utility/i,
  Amenities: /amenit|landscape|park|convenience|garden|central green/i,
  "Site Progress": /progress|construction/i,
};
// The gallery a visitor opens contains REAL photos only. An AI/CGI render may still
// serve as the category cover (prefer it for its polish); it is never in `images`.
const galleryCats = Object.entries(catMatch)
  .map(([name, re]) => {
    const all = galleryImages.filter((g) => re.test(g.type + " " + g.title)).map((g) => g.src!);
    const images = all.filter((src) => !isAiImage(src));
    const cover = all.find((src) => isAiImage(src)) ?? all[0];
    return { name, cover, images };
  })
  .filter((c) => c.images.length > 0);

const projectSchema = {
  "@context": "https://schema.org", "@type": "Residence", name: p.name,
  description: p.seoDescription ?? p.cardDescription ?? undefined,
  url: new URL(`/projects/${p.slug}`, site.url).href,
  ...(p.heroImage ? { image: new URL(p.heroImage, site.url).href } : {}),
  address: { "@type": "PostalAddress", addressLocality: p.city, addressRegion: p.state, addressCountry: "IN" },
};
---

<Layout
  title={p.seoTitle ?? `${p.name} | Cellular Realty`}
  description={p.seoDescription ?? p.cardDescription ?? undefined}
  ogImage={p.ogImage ?? undefined}
  jsonLd={[projectSchema]}
>
  {p.comingSoon ? (
    <!-- COMING SOON (Rewari teasers) -->
    <section class="relative flex min-h-[70vh] items-center overflow-hidden bg-brown-900 text-offwhite">
      <img src={p.heroImage ?? undefined} alt="" class="absolute inset-0 h-full w-full object-cover opacity-40" />
      <div class="absolute inset-0 bg-gradient-to-t from-brown-900 via-brown-900/70 to-brown-900/60"></div>
      <div class="container-content absolute inset-x-0 top-6 z-10">
        <a href="/projects" data-back-to-projects class="inline-flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.1em] text-offwhite/80 transition-colors hover:text-offwhite">
          <Icon name="lucide:arrow-left" class="h-4 w-4" /> Back to Projects
        </a>
      </div>
      <div class="container-content relative py-32 text-center">
        <span class="inline-block bg-brown-500 px-4 py-1.5 text-[12px] font-bold uppercase tracking-[0.14em] text-offwhite">Coming Soon</span>
        <h1 class="mx-auto mt-6 max-w-3xl font-display text-5xl leading-[1.05] lg:text-7xl">{p.name}</h1>
        <p class="mx-auto mt-5 max-w-xl text-lg text-offwhite/80">A planned plotted development in {locationFull}, currently under land procurement, to follow the group's established standards of organised, compliant development.</p>
        <div class="mt-9 flex justify-center gap-4">
          <Button enquire data-project={p.name} data-cta="Register Interest" variant="accent" size="lg">Register Interest</Button>
          <Button href="/contact" variant="outline-light" size="lg">Contact Us</Button>
        </div>
      </div>
    </section>
  ) : (
    <>
      <!-- ============ HERO (contained) ============ -->
      <section class="bg-offwhite pt-8 lg:pt-10">
        <div class="container-content">
          <a href="/projects" data-back-to-projects class="inline-flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.1em] text-brown-light transition-colors hover:text-brown-dark">
            <Icon name="lucide:arrow-left" class="h-4 w-4" /> Back to Projects
          </a>
        </div>
        <div class="container-content mt-5 grid gap-6 lg:grid-cols-[1.9fr_1fr]">
          <!-- image carousel -->
          <div class="relative aspect-[16/10] overflow-hidden rounded-[4px]">
            {heroImages.map((src, i) => (
              <img src={src} alt={`${p.name} ${i + 1}`} data-slide={i} loading={i === 0 ? "eager" : "lazy"} class:list={["absolute inset-0 h-full w-full object-cover transition-opacity duration-700", i === 0 ? "opacity-100" : "opacity-0"]} />
            ))}
            <div class="absolute inset-0 bg-gradient-to-t from-brown-900/85 via-transparent to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-8 text-offwhite">
              <h1 class="font-display text-4xl leading-tight lg:text-5xl">{p.name}</h1>
              {p.heroSubtitle && <p class="mt-2 text-lg text-offwhite/90">{p.heroSubtitle}</p>}
              <p class="mt-1 text-sm text-offwhite/70">{p.projectType} · {locationFull}</p>
              {heroImages.length > 1 && (
                <div class="mt-5 flex gap-2" data-dots>
                  {heroImages.map((_, i) => <button type="button" data-dot={i} aria-label={`Slide ${i + 1}`} class:list={["h-1.5 rounded-full transition-all", i === 0 ? "w-8 bg-brown-lightest" : "w-4 bg-offwhite/40"]} />)}
                </div>
              )}
            </div>
          </div>
          <!-- 3D masterplan (gated) + RERA QR -->
          <div class="flex flex-col gap-6">
            <div class="flex flex-col gap-3">
              <button type="button" data-enquire data-masterplan data-project={p.name} data-view3d={p.view3dLink ?? undefined} data-cta="Masterplan Unlock" class="group relative aspect-[4/3] overflow-hidden rounded-[4px] bg-brown-900 text-left">
                {p.view3dLink && <img data-mp-img src={p.view3dLink} alt="3D master plan" class="absolute inset-0 h-full w-full object-cover blur-[6px] transition group-hover:blur-[4px]" />}
                <div class="absolute inset-0 bg-brown-900/55"></div>
                <div data-mp-lock class="absolute inset-0 flex flex-col items-center justify-center text-offwhite">
                  <Icon name="lucide:lock" class="h-7 w-7" />
                  <span class="mt-3 text-[13px] font-semibold uppercase tracking-[0.12em]">3D Master Plan</span>
                  <span class="mt-1 text-[12px] text-offwhite/70">Unlock with your details</span>
                </div>
                <div data-mp-unlocked hidden class="absolute inset-0 flex flex-col items-center justify-center bg-brown-900/25 text-offwhite opacity-0 transition-opacity group-hover:opacity-100">
                  <Icon name="lucide:maximize" class="h-7 w-7" />
                  <span class="mt-3 text-[13px] font-semibold uppercase tracking-[0.12em]">View 3D Master Plan</span>
                </div>
              </button>
              {p.layoutPlanLink && (
                <a data-mp-layout href={p.layoutPlanLink} target="_blank" rel="noopener" hidden class="inline-flex items-center justify-center gap-2 rounded-[2px] border border-brown-dark/30 px-4 py-2.5 text-[12px] font-semibold uppercase tracking-[0.1em] text-brown-dark transition-colors hover:bg-brown-dark hover:text-offwhite">
                  <Icon name="lucide:file-text" class="h-4 w-4" /> View Layout Plan (PDF)
                </a>
              )}
            </div>
            {p.reraQr && (
              <div class="flex items-center gap-4 rounded-[4px] border border-[color:var(--color-line)] bg-offwhite p-4">
                <button type="button" data-lightbox data-lightbox-src={p.reraQr} data-lightbox-alt={`RERA QR – ${p.name}`} data-lightbox-group="rera-qr" class="shrink-0 rounded-[3px] transition-transform hover:scale-[1.03] focus:outline-none focus-visible:ring-2 focus-visible:ring-brown-lightest" aria-label="Enlarge RERA QR code">
                  <img src={p.reraQr} alt={`RERA QR – ${p.name}`} class="h-20 w-20 object-contain" />
                </button>
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-wider text-brown-light">RERA Registered</p>
                  <p class="mt-1 font-display text-lg text-brown-dark">{reraDisplay}</p>
                  <p class="mt-0.5 text-[11px] text-brown-light/70">Tap QR to enlarge</p>
                </div>
              </div>
            )}
          </div>
        </div>
      </section>

      <!-- ============ PROJECT OVERVIEW ============ -->
      <section class="bg-offwhite py-12 lg:py-16">
        <div class="container-content">
          <p class="eyebrow">Project Overview</p>
          <div class="mt-6 grid grid-cols-2 gap-8 lg:grid-cols-4">
            {[
              { label: "DTCP License", value: p.dtcpLicence },
              { label: "Total Plots", value: p.totalPlots ? `${p.totalPlots} Plots` : null },
              { label: "Plot Sizes", value: p.plotSizes },
              { label: "Total Area", value: p.landAreaDisplay },
            ].filter((s) => s.value).map((s) => (
              <div class="border-l-2 border-brown-lightest pl-4">
                <p class="text-[12px] font-semibold uppercase tracking-[0.1em] text-brown-light">{s.label}</p>
                <p class="mt-1.5 font-display text-2xl text-brown-dark lg:text-[26px]">{s.value}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ SECTION 01 — PROJECT SCOPE ============ -->
      {overview && (
        <section class="bg-offwhite py-20 lg:py-28">
          <div class="container-content grid gap-14 lg:grid-cols-2 lg:gap-16">
            <div>
              <p class="eyebrow">Section 01 / Project Scope</p>
              <h2 class="mt-4 font-display text-4xl leading-tight text-brown-dark lg:text-[46px]">{p.section01Title === "Project Overview" ? "Redefining Plotted Development" : (p.section01Title ?? "Project Scope")}</h2>
              <p class="mt-6 text-[16px] leading-[1.8] text-ink-soft">{overview}</p>
              <div class="mt-8 flex gap-10">
                {p.landAreaDisplay && <div class="border-l-2 border-brown-lightest pl-4"><p class="font-display text-2xl text-brown-dark">{p.landAreaDisplay}</p><p class="text-[12px] uppercase tracking-wide text-brown-light">Planned Development</p></div>}
                <div class="border-l-2 border-brown-lightest pl-4"><p class="font-display text-2xl text-brown-dark">RERA</p><p class="text-[12px] uppercase tracking-wide text-brown-light">Registered Project</p></div>
              </div>
            </div>
            {scopeImages.length > 0 && (
              <div class="relative aspect-[4/3] overflow-hidden rounded-[4px]" data-scope>
                {scopeImages.map((src, i) => <img src={src} alt={`${p.name} scope ${i + 1}`} data-scope-slide={i} loading="lazy" class:list={["absolute inset-0 h-full w-full object-cover transition-opacity duration-700", i === 0 ? "opacity-100" : "opacity-0"]} />)}
              </div>
            )}
          </div>
        </section>
      )}

      <!-- ============ SECTION 02 — AMENITIES ============ -->
      {amenities.length > 0 && (
        <section class="bg-brown-100/50 py-20 lg:py-28">
          <div class="container-content">
            <p class="eyebrow">Section 02 / Community Amenities</p>
            <h2 class="mt-4 font-display text-4xl text-brown-dark lg:text-[46px]">Community Infrastructure and Lifestyle Amenities</h2>
            <div class="mt-14 grid grid-cols-3 gap-x-6 gap-y-12 sm:grid-cols-4 lg:grid-cols-7">
              {amenities.map((a) => {
                const svg = amenitySvg(a.label);
                return (
                  <div class="flex flex-col items-center text-center">
                    {svg ? (
                      <img src={svg} alt={a.label} width="32" height="32" loading="lazy" class="h-8 w-8 object-contain" />
                    ) : (
                      <Icon name={amenityIcon(a.icon)} class="h-8 w-8 text-brown-lightest" />
                    )}
                    <p class="mt-3 text-[12px] font-medium uppercase leading-snug tracking-wide text-brown-dark">{a.label}</p>
                  </div>
                );
              })}
            </div>
          </div>
        </section>
      )}

      <!-- ============ SECTION 03 — CONNECTIVITY ============ -->
      {p.connectivity.length > 0 && (
        <section class="bg-offwhite py-20 lg:py-28">
          <div class="container-content grid gap-14 lg:grid-cols-2 lg:gap-16">
            <div>
              <p class="eyebrow">Section 03 / Connectivity</p>
              <h2 class="mt-4 font-display text-4xl leading-tight text-brown-dark lg:text-[46px]">Positioned for Regional Connectivity</h2>
              <div class="mt-10 space-y-8">
                {Object.entries(connGroups).map(([group, items]) => (
                  <div class="flex gap-4">
                    <Icon name={connIcon[group]} class="mt-1 h-6 w-6 shrink-0 text-brown-lightest" />
                    <div class="flex-1">
                      <h3 class="font-display text-xl text-brown-dark">{group}</h3>
                      <ul class="mt-2 space-y-1.5">
                        {items.slice(0, 4).map((c) => (
                          <li class="flex justify-between gap-4 text-[15px] text-ink-soft"><span>{c.place}</span><span class="whitespace-nowrap text-brown-light">{c.distance}</span></li>
                        ))}
                      </ul>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            {locationMap && <div class="lg:sticky lg:top-28 lg:self-start"><img src={locationMap} alt={`${p.name} location map`} class="w-full rounded-[4px] border border-[color:var(--color-line)] object-cover" loading="lazy" /></div>}
          </div>
        </section>
      )}

      <!-- ============ PROJECT GALLERY (categories) ============ -->
      {galleryCats.length > 0 && (
        <section class="bg-brown-100/50 py-20 lg:py-28">
          <div class="container-content text-center">
            <p class="eyebrow">Visual Journey</p>
            <h2 class="mt-4 font-display text-4xl text-brown-dark lg:text-[46px]">Project Gallery</h2>
            <p class="mx-auto mt-4 max-w-xl text-[16px] text-ink-soft">Select a category to open its gallery. Each set opens on its own, so you see only the images you chose.</p>
          </div>
          <div class="container-content mt-12" data-gallery-cats>
            <div class="grid gap-6 md:grid-cols-3">
              {galleryCats.map((c) => (
                <button
                  type="button"
                  data-gallery-cat
                  data-cat-images={JSON.stringify(c.images.map((src) => ({ src, alt: c.name })))}
                  class="group relative flex aspect-[4/3] w-full flex-col justify-end overflow-hidden rounded-[4px] text-left ring-1 ring-inset ring-brown-900/5 transition-shadow duration-300 hover:shadow-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brown-lightest"
                  aria-label={`Open ${c.name} gallery, ${c.images.length} ${c.images.length === 1 ? "photo" : "photos"}`}
                >
                  <img src={c.cover} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" />
                  <div class="absolute inset-0 bg-gradient-to-t from-brown-900/90 via-brown-900/25 to-transparent"></div>
                  <span class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-offwhite/15 text-offwhite backdrop-blur-sm transition-colors duration-300 group-hover:bg-brown-lightest group-hover:text-brown-900">
                    <Icon name="lucide:maximize-2" class="h-4 w-4" />
                  </span>
                  <span class="relative p-6">
                    <span class="block font-display text-2xl text-offwhite">{c.name}</span>
                    <span class="mt-1.5 inline-flex items-center gap-1.5 text-[12px] font-semibold uppercase tracking-[0.12em] text-offwhite/85">
                      View gallery
                      <span class="text-offwhite/50">·</span>
                      {c.images.length} {c.images.length === 1 ? "photo" : "photos"}
                      <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5" />
                    </span>
                  </span>
                </button>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- ============ SECTION 04 — DEVELOPMENT TIMELINE ============ -->
      {p.timeline.length > 0 && (
        <section class="bg-offwhite py-20 lg:py-28">
          <div class="container-content">
            <div class="flex flex-wrap items-end justify-between gap-6">
              <div>
                <p class="eyebrow">Section 04 / Development Progress</p>
                <h2 class="mt-4 font-display text-4xl text-brown-dark lg:text-[46px]">Development Timeline</h2>
              </div>
              <button type="button" data-progress-report class="inline-flex items-center gap-2 rounded-[2px] border border-brown-dark/30 px-5 py-3 text-[12px] font-semibold uppercase tracking-[0.1em] text-brown-dark hover:bg-brown-dark hover:text-offwhite">
                <Icon name="lucide:download" class="h-4 w-4" /> View Progress Report
              </button>
            </div>
            <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
              {p.timeline.map((t) => {
                const tone = timelineTone(t.status);
                return (
                  <div class="border-t-2 border-brown-lightest pt-5">
                    <p class="text-[12px] font-semibold uppercase tracking-wide text-brown-light">{t.phase}</p>
                    <h3 class="mt-2 font-display text-xl text-brown-dark">{t.title}</h3>
                    {tone && (
                      <span
                        class:list={[
                          "mt-3 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-wide",
                          tone === "done" && "bg-brown-lightest/25 text-brown-dark",
                          tone === "progress" && "bg-brown-100 text-brown-700",
                          tone === "pending" && "border border-brown-light/40 text-brown-light",
                        ]}
                      >
                        {tone === "done" && <Icon name="lucide:check" class="h-3.5 w-3.5" />}
                        {t.status}
                      </span>
                    )}
                    {t.targetDate && <p class="mt-1.5 text-sm text-brown-light">{t.targetDate}</p>}
                    {t.description && <p class="mt-2 text-sm leading-relaxed text-ink-soft">{t.description}</p>}
                  </div>
                );
              })}
            </div>
            <p data-progress-note hidden class="mt-6 text-sm italic text-brown-light">Monthly progress reports are coming soon. Share your details and we'll notify you when they're published.</p>
          </div>
        </section>
      )}

      <!-- ============ PLOT AVAILABILITY CTA ============ -->
      <section class="bg-brown-900 py-24 text-center text-offwhite">
        <div class="container-content">
          <h2 class="mx-auto max-w-3xl font-display text-4xl leading-tight lg:text-[52px]">Explore Plot Availability at {p.name}</h2>
          <p class="mx-auto mt-5 max-w-xl text-offwhite/75">Connect with our team to review available plots, project details and site visit options.</p>
          <div class="mt-9 flex flex-wrap justify-center gap-4">
            {brochure && <Button enquire data-project={p.name} data-cta="Download Brochure" data-download={brochure.file} variant="accent" size="lg" icon="lucide:download">Download Brochure</Button>}
            <Button enquire data-project={p.name} data-cta="Schedule a Visit" variant="outline-light" size="lg">Schedule a Visit</Button>
          </div>
        </div>
      </section>
    </>
  )}
  <Lightbox client:idle />
</Layout>

<script>
  const fade = (nodes: NodeListOf<HTMLElement>, n: number) => nodes.forEach((s, i) => { s.classList.toggle("opacity-100", i === n); s.classList.toggle("opacity-0", i !== n); });

  // Hero carousel
  const slides = document.querySelectorAll<HTMLElement>("[data-slide]");
  const dots = document.querySelectorAll<HTMLButtonElement>("[data-dot]");
  if (slides.length > 1) {
    let cur = 0;
    const show = (n: number) => {
      fade(slides, n);
      dots.forEach((d, i) => { d.classList.toggle("w-8", i === n); d.classList.toggle("bg-brown-lightest", i === n); d.classList.toggle("w-4", i !== n); d.classList.toggle("bg-offwhite/40", i !== n); });
      cur = n;
    };
    dots.forEach((d, i) => d.addEventListener("click", () => show(i)));
    setInterval(() => show((cur + 1) % slides.length), 5000);
  }

  // Scope carousel
  const scope = document.querySelectorAll<HTMLElement>("[data-scope-slide]");
  if (scope.length > 1) { let c = 0; setInterval(() => { c = (c + 1) % scope.length; fade(scope, c); }, 4500); }

  // Project Gallery — each category box opens ONLY its own images in the lightbox.
  // No images are shown until a category is selected; other categories never leak in.
  document.querySelectorAll<HTMLButtonElement>("[data-gallery-cat]").forEach((box) => {
    box.addEventListener("click", () => {
      let items: { src: string; alt?: string }[] = [];
      try { items = JSON.parse(box.dataset.catImages || "[]"); } catch {}
      if (!items.length) return;
      document.dispatchEvent(new CustomEvent("cr:lightbox", { detail: { items, index: 0 } }));
    });
  });

  // Progress report — coming soon note
  document.querySelector("[data-progress-report]")?.addEventListener("click", () => {
    const note = document.querySelector<HTMLElement>("[data-progress-note]");
    if (note) note.hidden = false;
  });

  // Back to Projects — use in-app history when the user arrived from a /projects page.
  document.querySelectorAll<HTMLAnchorElement>("[data-back-to-projects]").forEach((a) => {
    a.addEventListener("click", (e) => {
      try {
        const ref = document.referrer ? new URL(document.referrer) : null;
        if (ref && ref.origin === location.origin && ref.pathname.startsWith("/projects")) {
          e.preventDefault();
          history.back();
        }
      } catch {}
    });
  });

  // Persistent masterplan unlock (spec §5.2) — per project, survives refresh/later visits.
  const mpBtn = document.querySelector<HTMLElement>("[data-masterplan]");
  if (mpBtn) {
    const project = mpBtn.dataset.project || "";
    const view3d = mpBtn.dataset.view3d || "";
    const layoutEl = document.querySelector<HTMLAnchorElement>("[data-mp-layout]");
    const openPlan = (e?: Event) => {
      e?.preventDefault();
      const items: { src: string; alt: string }[] = [];
      if (view3d) items.push({ src: view3d, alt: "3D master plan" });
      if (items.length) document.dispatchEvent(new CustomEvent("cr:lightbox", { detail: { items, index: 0 } }));
    };
    const reveal = () => {
      mpBtn.removeAttribute("data-enquire");
      mpBtn.querySelector<HTMLElement>("[data-mp-img]")?.classList.remove("blur-[6px]", "group-hover:blur-[4px]");
      const lock = mpBtn.querySelector<HTMLElement>("[data-mp-lock]");
      if (lock) lock.hidden = true;
      const unlocked = mpBtn.querySelector<HTMLElement>("[data-mp-unlocked]");
      if (unlocked) unlocked.hidden = false;
      if (layoutEl) layoutEl.hidden = false;
      mpBtn.addEventListener("click", openPlan);
    };
    try {
      if (project && localStorage.getItem("cr_mp_unlock:" + project)) reveal();
    } catch {}
    document.addEventListener("cr:masterplan-unlocked", (ev) => {
      const detail = (ev as CustomEvent).detail;
      if (detail && detail.project === project) {
        reveal();
        openPlan();
      }
    });
  }
</script>
