---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/global";
const updated = "July 2026";

const sections = [
  {
    h: "1. Acceptance of these terms",
    p: [
      `This website is owned and operated by ${site.brand} ("Cellular Realty", "we", "us" or "our"). By accessing, browsing or using this website, you confirm that you have read, understood and agree to be bound by these Terms of Service and our Privacy Policy. If you do not agree, please discontinue use of the website.`,
      "These terms apply to all visitors and users of the website. We may update them from time to time; the version published here governs your use, and continued use after any change constitutes acceptance of the revised terms.",
    ],
  },
  {
    h: "2. Nature of the website: information only",
    p: [
      "This website is an informational and marketing platform intended to give prospective buyers and investors an overview of our plotted developments, brand and services. It is not a platform for booking, allotment, sale or transfer of any plot or property.",
      "Nothing on this website constitutes an offer, invitation to offer, or a legally binding contract of any kind. Any sale, allotment or booking is governed exclusively by the separate written agreements, application forms, allotment letters and statutory documents executed between you and the developer, and by the applicable approved layout and sanctions.",
    ],
  },
  {
    h: "3. Project information, approvals & RERA",
    p: [
      "Project details, including plot sizes, layouts, areas, amenities, distances, connectivity, timelines, specifications and imagery, are indicative, may be based on current plans, and are subject to change in accordance with the approved layout, the sanctioning authorities (including DTCP, Haryana) and applicable law.",
      "Each project displays its DTCP licence and, where registered, its RERA registration number on the relevant project page. Where a RERA registration is in process, this is stated as such and no bookings are solicited or accepted until registration is complete. Approval and licensing documents are available for inspection at our Corporate Office. Prospective buyers must independently verify all details and inspect original approvals before making any decision.",
    ],
  },
  {
    h: "4. Intellectual property",
    p: [
      `All content on this website, including text, graphics, logos, brand names, trademarks, photographs, renders, master plans, layout drawings, videos, and their selection and arrangement, is the property of ${site.brand} or its licensors and is protected under applicable intellectual-property laws.`,
      "You may view and print pages for your personal, non-commercial reference only. You may not reproduce, republish, distribute, modify, or create derivative works from any part of this website without our prior written permission.",
    ],
  },
  {
    h: "5. Enquiries, consent to contact & communications",
    p: [
      "When you submit an enquiry, request a call back, download a brochure, unlock a plan or subscribe to updates, you authorise us and our authorised representatives to contact you by phone, SMS, WhatsApp, email or other means in relation to your enquiry and our projects and services, notwithstanding any registration under Do-Not-Disturb / Do-Not-Call preferences.",
      "You are responsible for providing accurate information and for the security of your own devices and accounts. Please do not submit sensitive personal information beyond what a form requests.",
    ],
  },
  {
    h: "6. Third-party references & links",
    p: [
      "The website may reference third-party developments, infrastructure projects, institutions or locations, or contain links to third-party websites, solely for context and orientation. Such references do not imply any association, endorsement or responsibility, and we do not control and are not liable for third-party content, availability or accuracy.",
    ],
  },
  {
    h: "7. Prohibited use",
    p: [
      "You agree not to use the website unlawfully; to attempt to gain unauthorised access to it or its systems; to introduce malicious code; to scrape, harvest or misuse data; to impersonate any person; or to use the website in any way that could damage, disable or impair it or interfere with any other party's use.",
    ],
  },
  {
    h: "8. Disclaimers & limitation of liability",
    p: [
      'The website and its content are provided "as is" and "as available" without warranties of any kind, whether express or implied, including as to accuracy, completeness, merchantability or fitness for a particular purpose.',
      "To the maximum extent permitted by law, Cellular Realty and its parent, affiliates, directors, employees and agents shall not be liable for any direct, indirect, incidental, consequential or special loss or damage arising out of or in connection with your use of, or reliance on, this website or its content. Nothing on this website should be relied upon as legal, financial, tax or investment advice.",
    ],
  },
  {
    h: "9. Indemnity",
    p: [
      "You agree to indemnify and hold harmless Cellular Realty and its parent, affiliates and representatives from any claim, liability, cost or expense arising out of your breach of these terms or your misuse of the website.",
    ],
  },
  {
    h: "10. Changes to the website and terms",
    p: [
      "We may modify, suspend or discontinue any part of the website, and may revise these terms, at any time without prior notice. We are not obliged to update any information on the website, and it may not reflect the most current position.",
    ],
  },
  {
    h: "11. Governing law & jurisdiction",
    p: [
      "These terms are governed by and construed in accordance with the laws of India. The courts at Gurugram, Haryana shall have exclusive jurisdiction over any dispute arising out of or in connection with the website or these terms.",
    ],
  },
];
---

<Layout title="Terms of Service | Cellular Realty" description="Terms governing the use of the Cellular Realty website." noindex={true}>
  <section class="bg-offwhite py-16 lg:py-24">
    <div class="container-narrow">
      <p class="eyebrow">Legal</p>
      <h1 class="mt-4 font-display text-4xl text-brown-dark lg:text-6xl">Terms of Service</h1>
      <p class="mt-3 text-sm text-brown-light">Last updated: {updated}</p>

      <div class="mt-10 space-y-9 text-[16px] leading-relaxed text-ink-soft">
        {
          sections.map((s) => (
            <div>
              <h2 class="font-display text-2xl text-brown-dark">{s.h}</h2>
              {s.p.map((para) => <p class="mt-3">{para}</p>)}
            </div>
          ))
        }
        <div>
          <h2 class="font-display text-2xl text-brown-dark">12. Contact</h2>
          <p class="mt-3">
            For any question about these terms, contact us at
            <a href={`mailto:${site.email}`} class="text-brown-dark underline decoration-brown-lightest underline-offset-2"> {site.email}</a>
            {" "}or at our Corporate Office: {site.office.full}.
          </p>
        </div>
        <p class="border-t border-[color:var(--color-line)] pt-6 text-sm italic">
          This is a general template provided for convenience and must be reviewed, adapted and approved by qualified legal counsel before publication. It is not legal advice.
        </p>
      </div>
    </div>
  </section>
</Layout>
