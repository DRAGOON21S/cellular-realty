---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import BrandPillars from "../components/BrandPillars.tsx";
import FeaturedProjects, { type FeaturedItem } from "../components/FeaturedProjects.tsx";
import TestimonialsCarousel from "../components/TestimonialsCarousel.tsx";
import { Icon } from "astro-icon/components";
import { pillars } from "../data/pillars";
import { featuredProjects, articles, testimonials } from "../lib/cms";

const clients = ["CPWD", "Indian Railways", "PWD Haryana", "NBCC", "L&T Infra", "IVRCL", "Lafarge India", "Hero Realty"];

const metrics = [
  { icon: "lucide:award", value: "20+", label: "Years", caption: "Of Experience" },
  { icon: "lucide:building-2", value: "4+", label: "Premium", caption: "Developments" },
  { icon: "lucide:layout-grid", value: "700+", label: "Plots", caption: "Developed" },
  { icon: "lucide:map", value: "100+", label: "Acres", caption: "Developed" },
];

const featured: FeaturedItem[] = featuredProjects.map((p) => ({
  slug: p.slug,
  name: p.name,
  location: p.locationShort.includes(p.state) ? p.locationShort : `${p.locationShort}, ${p.state}`,
  landArea: p.landAreaDisplay ?? "—",
  plotSizes: p.plotSizes ?? "—",
  image: p.heroImage ?? p.cardImage ?? "/media/stock-images/stock-tree-lined-street.webp",
  badge: p.launchTag ?? p.status,
}));

const testItems = testimonials.map((t) => ({ name: t.name, role: t.role, quote: t.quote, rating: t.rating }));
const heroPoster = "/media/projects/south-city-greens/hero/south-city-greens-hero-entrance-gate.webp";
---

<Layout transparentHeader={true} newsletter={true}>
  <!-- ============ HERO ============ -->
  <section class="relative flex min-h-[100svh] items-center overflow-hidden bg-brown-900">
    <video class="absolute inset-0 h-full w-full object-cover" autoplay muted loop playsinline poster={heroPoster}>
      <source src="/media/homepage/hero-video/cellular-realty-homepage-hero.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-t from-brown-900/95 via-brown-900/45 to-brown-900/65"></div>
    <div class="container-content relative w-full py-40 text-offwhite">
      <p class="eyebrow text-brown-300">Engineering Excellence Since 2005</p>
      <h1 class="mt-6 max-w-4xl font-display text-[44px] leading-[1.05] sm:text-6xl lg:text-[76px]">
        Building <em class="italic text-brown-300">communities</em><br />Cell by Cell
      </h1>
      <p class="mt-6 max-w-xl text-lg text-offwhite/85 lg:text-xl">
        Thoughtfully planned plotted developments across Delhi NCR, created for confident ownership
        and long-term growth.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <Button href="/projects" variant="accent" size="lg">Explore More</Button>
        <Button enquire data-cta="Schedule a Call" variant="outline-light" size="lg">Schedule a Call</Button>
      </div>
    </div>
  </section>

  <!-- ============ TRUST METRICS ============ -->
  <section class="border-b border-[color:var(--color-line)] bg-offwhite">
    <div class="container-content grid grid-cols-2 gap-y-10 py-14 lg:grid-cols-4 lg:gap-0">
      {
        metrics.map((m, i) => (
          <div class:list={["flex items-center gap-4 px-4 lg:px-8", i > 0 && "lg:border-l lg:border-[color:var(--color-line)]"]}>
            <Icon name={m.icon} class="h-8 w-8 shrink-0 text-brown-lightest" />
            <div>
              <p class="font-display text-3xl leading-none text-brown-dark lg:text-[34px]">
                {m.value} <span class="text-2xl lg:text-3xl">{m.label}</span>
              </p>
              <p class="mt-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-brown-light">{m.caption}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ BRAND PILLARS — Rooted in Experience ============ -->
  <section class="bg-offwhite py-24 lg:py-32">
    <div class="container-content grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow">Our Brand Pillars</p>
        <h2 class="mt-4 font-display text-4xl leading-[1.1] text-brown-dark lg:text-[52px]">
          Rooted in Experience.<br />Built for What's Next.
        </h2>
        <p class="mt-6 text-[16px] leading-[1.8] text-ink-soft">
          Cellular Realty is a modern real estate development company built on a simple yet
          meaningful vision — creating thoughtfully planned communities that people are proud to call home.
        </p>
        <p class="mt-4 text-[16px] leading-[1.8] text-ink-soft">
          In a rapidly expanding real estate landscape, we exist to transform land into thriving
          communities, offering homebuyers and investors the confidence to build their future in
          destinations with strong growth potential.
        </p>
        <div class="mt-9">
          <Button href="/about" variant="outline">Discover Our Story</Button>
        </div>
      </div>
      <BrandPillars pillars={pillars} variant="panel" client:visible />
    </div>
  </section>

  <!-- ============ FEATURED PLOTTED DEVELOPMENT ============ -->
  <section class="bg-brown-100/50 py-24 lg:py-32">
    <div class="container-content">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-xl">
          <p class="eyebrow">Our Portfolio</p>
          <h2 class="mt-4 font-display text-4xl text-brown-dark lg:text-[52px]">Featured Plotted Development</h2>
          <p class="mt-4 text-[16px] text-ink-soft">A planned plotted community with developed internal roads, green avenues, parks and lifestyle amenities.</p>
        </div>
        <Button href="/projects" variant="outline">View All Projects</Button>
      </div>
      <div class="mt-14">
        <FeaturedProjects items={featured} client:visible />
      </div>
    </div>
  </section>

  <!-- ============ ASSOCIATED COMPANIES ============ -->
  <section class="overflow-hidden border-y border-[color:var(--color-line)] bg-offwhite py-14">
    <div class="marquee">
      <ul class="marquee__track">
        {[...clients, ...clients].map((c) => <li class="mx-10 font-display text-2xl text-brown-light/70 lg:text-3xl">{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- ============ LATEST INSIGHTS ============ -->
  <section class="bg-offwhite py-24 lg:py-32">
    <div class="container-content">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">Latest Insights</p>
          <h2 class="mt-4 font-display text-4xl text-brown-dark lg:text-[52px]">Location, Growth &amp; Ownership Insights</h2>
        </div>
        <Button href="/insights" variant="outline">View All Insights</Button>
      </div>
      <div class="mt-14 grid gap-10 md:grid-cols-2 lg:grid-cols-3">
        {
          articles.map((a) => (
            <article class="group flex flex-col">
              <a href={`/insights/${a.slug}`} class="block aspect-[16/10] overflow-hidden">
                <img src={a.image ?? "/media/stock-images/stock-tree-lined-street.webp"} alt={a.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" />
              </a>
              <p class="mt-6 text-[12px] font-semibold uppercase tracking-[0.12em] text-brown-lightest">{a.category} • {a.readTime}</p>
              <h3 class="mt-3 font-display text-[26px] leading-tight text-brown-dark"><a href={`/insights/${a.slug}`} class="hover:text-brown-600">{a.title}</a></h3>
              <p class="mt-3 line-clamp-3 text-[15px] leading-relaxed text-ink-soft">{a.excerpt}</p>
              <a href={`/insights/${a.slug}`} class="mt-5 inline-flex items-center gap-2 text-[12px] font-semibold uppercase tracking-[0.12em] text-brown-dark">
                Read Article <Icon name="lucide:arrow-right" class="h-4 w-4" />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="bg-brown-100/50 py-24 lg:py-32">
    <div class="container-content">
      <p class="eyebrow text-center">Testimonials</p>
      <h2 class="mt-4 text-center font-display text-4xl text-brown-dark lg:text-[52px]">Voices of Trust</h2>
      <div class="mt-14">
        <TestimonialsCarousel items={testItems} client:visible />
      </div>
    </div>
  </section>
</Layout>

<style>
  .marquee { width: 100%; overflow: hidden; }
  .marquee__track { display: flex; width: max-content; animation: marquee-scroll 38s linear infinite; }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  @keyframes marquee-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee__track { animation: none; } }
</style>
