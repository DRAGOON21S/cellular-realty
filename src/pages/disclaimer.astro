---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/global";
const updated = "July 2026";
---

<Layout title="Disclaimer — Cellular Realty" description="Legal disclaimer for the Cellular Realty website." noindex={true}>
  <section class="bg-offwhite py-16 lg:py-24">
    <div class="container-narrow">
      <p class="eyebrow">Legal</p>
      <h1 class="mt-4 font-display text-4xl text-brown-dark lg:text-6xl">Disclaimer</h1>
      <p class="mt-3 text-sm text-brown-light">Last updated: {updated}</p>

      <div class="prose-legal mt-10 space-y-6 text-[16px] leading-relaxed text-ink-soft">
        <p>
          The information on this website is for general information only and does not constitute an
          offer, invitation or solicitation of any kind. While every effort is made to keep the
          content accurate and current, {site.brand} makes no representation or warranty as to its
          completeness or accuracy.
        </p>
        <p>
          Visuals including renders, 3D master plans, aerial views and lifestyle imagery are
          artistic impressions and may be indicative or representative. Plot sizes, areas,
          amenities, distances, timelines and specifications are subject to change and to the
          approved layout and applicable approvals.
        </p>
        <p>
          <strong class="text-brown-dark">RERA:</strong> Each project displays its DTCP licence and,
          where registered, its RERA registration number on the respective project page. Where a RERA
          registration is in process, this is stated as such and no bookings are solicited until
          registration is complete. Approval and licensing documents are available for inspection at
          our Corporate Office.
        </p>
        <p>
          Bank loan facilities, where mentioned, may be available from nationalised banks for
          eligible buyers and are subject to the respective bank's terms and approvals. Pricing is
          shared on request and is subject to revision.
        </p>
        <p>
          Nothing on this website should be relied upon as legal, financial or investment advice.
          Prospective buyers are advised to verify all details independently and to inspect the
          original approval documents before making any decision.
        </p>
        <p class="text-sm">
          This is a general template and should be reviewed and approved by legal counsel before
          publication.
        </p>
      </div>
    </div>
  </section>
</Layout>
